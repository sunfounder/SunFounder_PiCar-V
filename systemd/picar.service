[Unit]
Description=PiCar-V Web Control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rpicar
WorkingDirectory=/home/rpicar/SunFounder_PiCar-V/remote_control
EnvironmentFile=/home/rpicar/SunFounder_PiCar-V/.env
ExecStart=/home/rpicar/SunFounder_PiCar-V/.venv/bin/python3 manage.py runserver 0.0.0.0:8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
